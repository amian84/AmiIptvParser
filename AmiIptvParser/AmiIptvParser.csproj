<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>AmiIptvParser</PackageId>
    <Version>1.0.0</Version>
    <Title>AmiIptvParser</Title>
    <Authors>David Amian</Authors>
    <Description>Parse IPTV playlists in M3U and M3U8 format.</Description>
    <Copyright>Copyright (c) 2022 David Amian</Copyright>
    <PackageTags>iptv;m3u;m3u8;playlist;parser</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/amian84/AmiIptvParser</PackageProjectUrl>
    <RepositoryUrl>https://github.com/amian84/AmiIptvParser</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReleaseNotes>Breaking 1.0 API: dependency-free M3U parser, immutable entries, and PlaylistClient over an injected HttpClient. Removes the static AmiParser facade, disk cache, and PlaylistsNET.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
